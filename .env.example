# NovaBank - Enterprise AI-Powered Banking Platform
# ==================================================
# Copy this file to .env and customize values before running docker-compose up

# PostgreSQL
POSTGRES_DB=banking_auth
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_pass_123

# Redis
REDIS_PASSWORD=redis_pass_123

# JWT Secret (change in production!)
JWT_SECRET=dGhpc0lzQVZlcnlTZWN1cmVTZWNyZXRLZXlGb3JKYXZhQmFua2luZ0FwcEVudGVycHJpc2VNb2Rl

# Ollama (local LLM for AI agent)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB (vector database for RAG)
CHROMA_URL=http://chromadb:8000

# MongoDB
MONGO_INITDB_DATABASE=banking_accounts
